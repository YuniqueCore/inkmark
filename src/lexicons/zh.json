    {
      "id": "false_insight",
      "label": "假揭示与深度表演",
      "note": "看似 X 实则 Y、这背后是 Z：两项都是抽象评价、没有事实建立层次时才处理。",
      "entries": [
        {
          "p": "看似[^，。；！？]{1,20}(?:实则|实际上|其实是|背后是)",
          "w": 2,
          "fix": "用事实先建立关系，再写归因"
        },
        {
          "p": "这背后的(?:原因|逻辑|真相|秘密)",
          "w": 2
        },
        {
          "p": "真正的(?:原因|问题|答案|关键|区别)(?:往往|其实|恰恰)?(?:是|在于)",
          "w": 2
        },
        {
          "p": "本质上(?:是|在于)",
          "w": 1
        },
        {
          "p": "深层次的(?:原因|逻辑)",
          "w": 2
        },
        {
          "p": "这(?:无疑|恰恰)?说明",
          "w": 1
        },
        {
          "p": "由此可见",
          "w": 2
        },
        {
          "p": "不难(?:看出|发现|想象)",
          "w": 2
        },
        {
          "p": "(?:引人深思|发人深省|值得深思)",
          "w": 2
        },
        {
          "p": "(?:这|它)(?:提醒|告诉)我们",
          "w": 2,
          "fix": "删掉说教框架，直接给结论"
        },
        {
          "p": "从这个(?:角度|维度|层面)(?:来看|出发)",
          "w": 1
        },
        {
          "p": "所谓[^。；！？]{1,16}(?:不过是|只不过是|只是)",
          "w": 2,
          "note": "B16「所谓X不过是Y」生硬点题",
          "fix": "直接说Y，或承认X是什么再补限制条件"
        },
        {
          "p": "(?:显而易见|不言而喻|可想而知|一言以蔽之)",
          "w": 1,
          "note": "把推论责任推给读者的盖章词",
          "fix": "补上推论所依据的事实，或删掉让读者自己判断"
        },
        {
          "p": "(?:原因|答案|关键|道理)(?:其实)?很简单[：:]",
          "w": 1,
          "note": "上位语法：宣告深刻但不增加信息",
          "fix": "删宣告，直接给原因"
        },
        {
          "p": "理解了[^。；！？]{1,16}，?(?:我们)?就(?:能|会)明白",
          "w": 1,
          "fix": "删导读宣告，信任读者自己连结"
        },
        {
          "p": "(?:各有优缺点|因人而异|见仁见智|取决于[^，。！？]{0,8}(?:因素|情况|需求))",
          "w": 1,
          "note": "立场真空：整段没有判断时处理；真有分支条件时放行",
          "fix": "写出作者的实际选择与理由；作者没给就标注缺判断"
        },
        {
          "p": "面子(?:上)?是[^，。！？]{1,10}，?里子(?:是|上)?",
          "w": 2,
          "note": "面子/里子二元框架，同「看似实则」族",
          "fix": "直接铺事实差异，不套二元壳"
        }
      ]
