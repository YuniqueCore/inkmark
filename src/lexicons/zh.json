  "categories": [
    {
      "id": "canned_openers",
      "label": "万能开场与任务复述",
      "note": "开头只营造宏大感或复述任务，删掉后信息不受损。背景本身解释后文条件或时间时保留。",
      "entries": [
        {
          "p": "随着[^，。；！？]{0,16}的(?:不断|飞速|迅猛|持续|快速发展)",
          "w": 2,
          "fix": "直接从事实或动作开始"
        },
        {
          "p": "在(?:当今|这个|现今|如今)[^，。；！？]{0,10}(?:时代|背景下|大背景下)",
          "w": 2,
          "fix": "删除，或给出具体时间地点"
        },
        {
          "p": "众所周知",
          "w": 2,
          "fix": "直接陈述事实"
        },
        {
          "p": "在这个(?:充满|信息)[^，。；！？]{2,10}的(?:时代|社会|世界里)",
          "w": 2
        },
        {
          "p": "当我们谈论",
          "w": 2
        },
        {
          "p": "提到[^，。；！？]{1,12}，?(?:很多人|大家|相信不少人)",
          "w": 1,
          "note": "口语写作中可接受，密集时处理"
        },
        {
          "p": "不可否认",
          "w": 2
        },
        {
          "p": "毫无(?:疑问|争议)的是",
          "w": 2
        },
        {
          "p": "毋庸置疑",
          "w": 2
        },
        {
          "p": "本文(?:旨在|将(?:从|为))",
          "w": 1,
          "note": "论文摘要等正式体裁受保护"
        },
        {
          "p": "基于(?:以上|上述|你的)需求",
          "w": 2
        },
        {
          "p": "下面(?:将)?从[^，.；！？]{1,12}(?:方面|维度|角度)",
          "w": 2,
          "fix": "直接进入第一点"
        },
        {
          "p": "说白了|说穿了|先说结论|归根结底|说到底",
          "w": 1,
          "note": "B10 起手式：结论前垫的壳，删掉后判断直接开场",
          "fix": "删掉，直接给判断"
        },
        {
          "p": "不容忽视的是|不得不(?:说|承认)",
          "w": 1,
          "fix": "删壳，把后半句直接说出来"
        },
        {
          "p": "(?:坦白(?:的)?(?:说|来讲)|说得直白(?:点|些)?|直白点说|坦率地讲)",
          "w": 1,
          "note": "伪坦率标签：把「我替你戳穿表面」挂在嘴边",
          "fix": "删标签，让事实自己说话"
        },
        {
          "p": "(?:一句话概括|简单来说|简单点儿说|换个角度看|不妨这样理解)",
          "w": 1,
          "fix": "删引导语，直接给概括内容"
        },
        {
          "p": "(?:接下来我们将|下面我会)",
          "w": 1,
          "fix": "删预告，直接开讲"
        }
      ]
    },
    {
