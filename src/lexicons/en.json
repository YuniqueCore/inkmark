          "p": "\\binsights?\\b",
          "w": 0,
          "mode": "density",
          "density_min": 3,
          "density_w": 2,
          "fix": "what did you learn that you can act on"
        },
        {
          "p": "\\bfindings\\b",
          "w": 0,
          "mode": "density",
          "density_min": 3,
          "density_w": 1,
          "fix": "state the finding"
        },
        {
          "p": "\\b[Ee]xhibi(?:t|ts|ted|ting)\\b",
          "w": 0,
          "mode": "density",
          "density_min": 2,
          "density_w": 2,
          "fix": "showed"
        },
        {
          "p": "\\balign(?:s|ed|ing)? with\\b",
          "w": 0,
          "mode": "density",
          "density_min": 3,
          "density_w": 1,
          "fix": "matches, fits, agrees with"
        },
        {
          "p": "\\b[Nn]ovel\\b",
          "w": 0,
          "mode": "density",
          "density_min": 3,
          "density_w": 2,
          "fix": "say what is actually new"
        }
      ]
    },
    {
      "id": "transitions",
      "label": "Transitions & filler frames",
      "note": "Restructure so the connection is obvious, or cut. One deliberate use in the writer's own voice is fine.",
      "entries": [
        {
          "p": "\\bMoreover,|\\bFurthermore,|\\bAdditionally,",
          "w": 1,
          "fix": "and, also, on top of that; or restructure"
        },
        {
          "p": "\\bIn conclusion,|\\bIn summary,|\\bTo sum up,?",
          "w": 2,
          "fix": "end on the last concrete point"
        },
        {
          "p": "\\bIt'?s (?:important|worth) (?:to note|noting) (?:that )?",
          "w": 2,
          "fix": "just state it"
        },
        {
          "p": "\\bAt the end of the day,?",
          "w": 2,
          "fix": "cut"
        },
        {
          "p": "\\bWhen it comes to\\b",
          "w": 1,
          "fix": "talk about the thing directly"
        },
        {
          "p": "\\bIn today'?s\\b",
          "w": 2,
          "fix": "state the specific context"
        },
        {
          "p": "\\bIn an era where\\b",
          "w": 2
        },
        {
          "p": "\\bThat (?:being )?said,?",
          "w": 1,
          "fix": "but, yet; don't overuse"
        },
        {
          "p": "\\bNeedless to say,?",
          "w": 2
        },
        {
          "p": "\\bThe reality is that\\b",
          "w": 2,
          "fix": "cut or state the claim"
        },
        {
          "p": "\\bIn terms of\\b",
          "w": 1,
          "evidence": false,
          "fix": "rewrite"
        },
        {
          "p": "\\bgoing forward,?",
          "w": 1
        },
        {
          "p": "\\bIn essence,?|\\bUltimately,?|\\bConsequently,",
          "w": 1,
          "fix": "restructure so the connection is obvious, or cut"
        },
        {
          "p": "\\bNotably,|\\bImportantly,",
          "w": 1,
          "fix": "if it matters, the sentence should show it"
        },
        {
          "p": "^(?:Essentially|Fundamentally|Specifically|Significantly),",
          "w": 1,
          "flags": [
            "MULTILINE"
          ],
          "fix": "cut the sentence opener"
        },
        {
          "p": "\\b[Ii]t is (?:important|worth) (?:to note|noting) that\\b",
          "w": 2,
          "fix": "just state it"
        },
        {
          "p": "\\b[Oo]ne must (?:remember|note|understand)\\b",
          "w": 2,
          "fix": "state the fact directly"
        },
        {
          "p": "\\b[Gg]enerally speaking,?\\b|\\b[Ii]t should be noted that\\b",
          "w": 1,
          "fix": "state the fact; drop the throat-clear"
        }
      ]
    },
    {
      "id": "chatbot_residue",
      "label": "Chatbot artifacts & meta-narration",
      "note": "Conversational tics from chat interfaces, not writing. Remove entirely.",
      "entries": [
        {
          "p": "\\bI hope this helps",
          "w": 3
        },
        {
          "p": "(?:^|\\n)\\s*(?:Certainly|Absolutely|Of course|Great question)[!.]",
          "w": 3,
          "note": "仅命中独立短句回答；「Of course, ...」让步从句不受影响"
        },
        {
          "p": "\\bFeel free to (?:reach out|let me know)",
          "w": 3
        },
        {
          "p": "\\bLet me know if (?:you|this)",
          "w": 3
        },
        {
          "p": "\\bHere'?s the (?:thing|deal):?",
          "w": 3,
          "fix": "cut and state the point"
        },
        {
          "p": "\\bLet'?s (?:dive in|explore|take a look|break this down|unpack)",
          "w": 3,
          "fix": "start with the point"
        },
        {
          "p": "\\bBuckle up",
          "w": 3
        },
        {
          "p": "\\bLook no further",
          "w": 3
        },
        {
          "p": "\\bAs an AI(?: language model)?\\b",
          "w": 3
        },
        {
          "p": "\\b(?:up to|as of) my last (?:training )?update\\b",
          "w": 3
        },
        {
          "p": "\\bIn this (?:article|post|essay),? we (?:will|'?ll) (?:explore|discuss|take)",
          "w": 3,
          "fix": "direct opening"
        },
        {
          "p": "\\bWhat if I told you",
          "w": 3
        },
        {
          "p": "\\bThink about it:?",
          "w": 2
        },
        {
          "p": "\\b(?:Experts|Studies|Research) (?:agree|show|suggest|indicate)\\b",
          "w": 2,
          "fix": "name the source, or cut the claim"
        },
        {
          "p": "\\b(?:marking|mark) a pivotal moment\\b",
          "w": 3,
          "fix": "state what happened"
        },
        {
          "p": "\\bThe future looks bright\\b",
          "w": 3,
          "fix": "say something specific or nothing"
        },
        {
          "p": "\\bOnly time will tell\\b",
          "w": 3
        },
        {
          "p": "\\b[Bb]ased on the (?:information|context) provided\\b",
          "w": 2,
          "fix": "cut; answer the question directly"
        },
        {
          "p": "\\b[Ii] hope this (?:email|message) finds you well\\b",
          "w": 2,
          "fix": "delete the pleasantry"
        },
        {
          "p": "\\b[Ee]ver wondered\\b",
          "w": 2,
          "fix": "engagement bait; state the answer"
        },
        {
          "p": "\\b[Yy]ou'?re absolutely right\\b",
          "w": 2,
          "fix": "cut the flattery, answer directly"
        },
        {
          "p": "\\b[Ii] cannot (?:browse|access) the (?:internet|web)\\b|\\b(?:no|don'?t have) access to real-time\\b",
          "w": 2,
          "fix": "capability disclaimer; state what the source shows"
        },
        {
          "p": "\\b[Ww]hat would you like me to\\b",
          "w": 2,
          "fix": "answer, then offer one concrete next step"
        },
        {
          "p": "\\b[Ll]et'?s be (?:honest|real),?",
          "w": 2,
          "note": "performed candor",
          "fix": "make the point without announcing honesty"
        },
        {
          "p": "\\b[Ww]ithout further ado,?\\b",
          "w": 2,
          "fix": "delete the announcement"
        },
        {
          "p": "\\b[Ww]hat a (?:fascinating|great|wonderful)\\b",
          "w": 2,
          "fix": "cut the flattery (unslop sycophancy list)"
        }
      ]
    },
    {
      "id": "structural",
      "label": "Structural & formatting patterns",
      "note": "Regex-level structural tells. Each finding is a candidate; meaning and genre decide.",
      "entries": [
        {
          "p": "\\bnot [^.!?]{3,60}\\bbut\\b",
          "w": 3,
          "flags": [
            "IGNORECASE"
          ],
          "fix": "state the point directly",
          "note": "negative parallelism (adapted from antislop-sampler)"
        },
        {
          "p": "\\b(?:isn'?t|not) (?:just|merely|simply)[^.!?]{3,60}\\b(?:it'?s|but)\\b",
          "w": 3,
          "flags": [
            "IGNORECASE"
          ],
          "note": "not just X, it's Y"
        },
        {
          "p": "\\bIt'?s not [^.!?]{2,50}\\.\\s*It'?s\\b",
          "w": 3,
          "note": "split-sentence binary contrast"
        },
        {
          "p": "\\b(?:Not|Never) [a-z][^.!?]{1,30}\\.\\s*(?:Not|No)\\b",
          "w": 2,
          "note": "negative listing"
        },
        {
          "p": "\\bImagine a world where\\b",
          "w": 3,
          "fix": "state the claim at the same confidence"
        },
        {
          "p": "\\bPicture a (?:future|world)\\b",
          "w": 3
        },
        {
          "p": "\\bWhether you'?re (?:a|an) [^.!?]{3,50} or (?:a|an)\\b",
          "w": 2,
          "fix": "pick the audience you are addressing"
        },
        {
          "p": " — ",
          "w": 0,
          "mode": "density",
          "density_min": 4,
          "density_w": 2,
          "fix": "periods, commas, colons, parentheses",
          "note": "em dash as universal connector"
        },
        {
          "p": "(?:(?:^|\\s)#[A-Za-z0-9_]+){6,}",
          "w": 2,
          "flags": [
            "MULTILINE"
          ],
          "note": "hashtag stuffing; issue refs, hex colors, code excluded by prose-only scan"
        },
        {
          "p": "\\b(?:could potentially|may eventually|might ultimately|will potentially)\\b",
          "w": 2,
          "fix": "keep the one qualifier that carries the uncertainty"
        },
        {
          "p": "\\b(?:delve|dive|journey) into the (?:world|realm) of\\b",
          "w": 3
        },
        {
          "p": "\\b(?:a testament to|a symbol of) (?:the )?(?:human|enduring|lasting)\\b",
          "w": 3
        },
        {
          "p": "\\b(?:highlighting|underscoring|reflecting|emphasizing|symbolizing|showcasing) (?:the|its)\\b",
          "w": 2,
          "fix": "keep only what the source supports",
          "note": "superficial -ing rider"
        },
        {
          "p": "\\b(?:Despite|Against) (?:these )?challenges[^.!?]{0,60}(?:continues to|remains)\\b",
          "w": 3,
          "fix": "name the challenge and the response, or cut"
        },
        {
          "p": "\\bThe (?:result|answer|catch|kicker|bottom line|best part|worst part|irony|twist|takeaway|lesson|upside|downside|trade-?off|verdict|caveat|fix|short answer|hard part|scary part|surprising part|interesting part|point)\\?",
          "w": 2,
          "fix": "integrate the point into the surrounding sentence",
          "note": "rhetorical self-answer: question mark used as a drumroll"
        },
        {
          "p": "\\bThe (?:price|catch|kicker|upshot|tradeoff|trade-off|trick|cost|downside|flip side|bottom line|takeaway|result|answer|reason|lesson|moral|point|pitch|fix|payoff):",
          "w": 1,
          "fix": "write the sentence out; the label adds no information",
          "note": "label-and-explain colon"
        },
        {
          "p": "\\*\\*(?:Key (?:insight|takeaway|point)|Important|Note|Bottom line|The point)[.:]?\\*\\*",
          "w": 2,
          "fix": "cut the leftover chatbot markup",
          "note": "leftover AI markup"
        },
        {
          "p": "\\bThis matters because\\b|\\bThe (?:key|point|insight|idea|important thing) here is\\b",
          "w": 2,
          "fix": "delete the meta-commentary, keep the point"
        },
        {
          "p": "\\b[Tt]his is where [^\\n.!?]{1,40} comes in\\b",
          "w": 2,
          "fix": "state the thing's role directly"
        },
        {
          "p": "\\b[Tt]hink of it as\\b",
          "w": 1,
          "fix": "if the analogy explains a mechanism, keep it without the prompt"
        },
        {
          "p": "\\bpav(?:es|ed|ing) the way\\b",
          "w": 1,
          "fix": "enabled, made possible"
        },
        {
          "p": "\\bshed light on\\b",
          "w": 1,
          "fix": "explained, revealed"
        },
        {
          "p": "\\bleft an indelible mark\\b",
          "w": 2,
          "fix": "say what changed and how it still shows"
        },
        {
          "p": "\\bsetting the stage for\\b",
          "w": 1,
          "fix": "made the next step possible"
        },
        {
          "p": "\\bthe transformative power of\\b",
          "w": 2,
          "fix": "say what it changes, for whom"
        },
        {
          "p": "\\boffers? a glimpse (?:into|of)\\b",
          "w": 1,
          "fix": "shows a bit of; or name what is shown"
        },
        {
          "p": "\\b[Mm]ake no mistake,?\\b",
          "w": 2,
          "note": "emphasis crutch",
          "fix": "show why it matters instead of asserting it"
        },
        {
          "p": "\\b[Ll]et me walk you through\\b",
          "w": 2,
          "fix": "delete the tour-guide frame"
        },
        {
          "p": "\\b[Hh]ere'?s the truth[,:]\\b|\\b[Yy]ou'?ve been (?:told|led to believe)\\b",
          "w": 1,
          "note": "corrective reveal posture",
          "fix": "make the claim with evidence, skip the reveal frame"
        },
        {
          "p": "\\b[Ii]t wasn'?t [^.!?]{1,40}\\. [Ii]t wasn'?t",
          "w": 2,
          "note": "negative-listing staccato",
          "fix": "state the one thing that was true"
        },
        {
          "p": "\\b[Ss]omething (?:shifted|changed)\\.|\\b[Ee]verything changed\\.|\\b[Aa]nd then it hit me\\b",
          "w": 2,
          "note": "dramatic fragment",
          "fix": "say what actually happened"
        },
        {
          "p": "\\b(?:20\\d{2}-xx-xx|20\\d{2}-01-0[xX])\\b|\\baccess-date=20\\d{2}",
          "w": 2,
          "note": "leftover template data",
          "fix": "fill or remove the placeholder"
        },
        {
          "p": "\\bserves as a (?:powerful |sobering |stark |timely )?reminder (?:that|of)\\b",
          "w": 2,
          "fix": "say what reminds whom of what"
        },
        {
          "p": "\\b[Rr]esults may vary\\b",
          "w": 1,
          "fix": "give the actual range or drop the claim"
        },
        {
          "p": "\\bmore than just\\b|\\bgoes? beyond\\b",
          "w": 1,
          "note": "negative-parallelism kin (slopbuster #9)",
          "fix": "state Y directly"
        },
        {
          "p": "(?:[Ff]rom [^.;!?]{2,40} to [^.;!?]{2,40}[;,]?\\s*){2,}",
          "w": 2,
          "note": "false-range sweep: chained from-X-to-Y (slopbuster #12)",
          "fix": "list the actual topics"
        }
      ]
    }
  ]
}
