{
  "name": "inkmark",
  "private": true,
  "version": "0.13.1",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "description": "划词批注工作台：给 AI 改过的文本做行内批注，一键导出原文+批注 / 片段+批注 / 评审引用块",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --base=/inkmark/",
    "preview": "vite preview",
    "test": "vitest run && vitest run --config vitest.native.config.ts",
    "check": "tsc --noEmit && bun run test && bun run test:e2e",
    "test:e2e": "bun run build:native-web && playwright test",
    "build:native-web": "tsc --noEmit && vite build --mode native && node scripts/native-web.mjs && node scripts/native-prepare.mjs",
    "native:setup": "node scripts/native-setup.mjs",
    "nsh": "node scripts/nsh.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/morphdom": "^2.4.2",
    "@types/node": "^26.6.6",
    "@types/truncate-utf8-bytes": "^1.0.2",
    "happy-dom": "^21.0.4",
    "parse5": "^8.1.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@noble/hashes": "^2.4.0",
    "approx-string-match": "^2.0.1",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "image-size": "^2.1.0",
    "konva": "^10.9.1",
    "micromark": "^4.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-util-types": "^2.0.3",
    "morphdom": "^2.7.8",
    "sanitize-filename": "^1.6.5",
    "truncate-utf8-bytes": "^1.0.2",
    "valibot": "^1.5.0"
  }
}
