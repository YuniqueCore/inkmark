{
  "name": "inkmark",
  "private": true,
  "version": "0.10.2",
  "description": "划词批注工作台：给 AI 改过的文本做行内批注，一键导出原文+批注 / 片段+批注 / 评审引用块",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --base=/inkmark/",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run && playwright test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "approx-string-match": "^2.0.0",
    "fflate": "^0.8.3"
  }
}
