{
  "name": "inkmark",
  "private": true,
  "version": "0.11.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "description": "划词批注工作台：给 AI 改过的文本做行内批注，一键导出原文+批注 / 片段+批注 / 评审引用块",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --base=/inkmark/",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run && playwright test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/morphdom": "^2.4.2",
    "@types/node": "^26.6.6",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@annotorious/annotorious": "^3.9.5",
    "@floating-ui/dom": "^1.8.0",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@noble/hashes": "^2.4.0",
    "approx-string-match": "^2.0.1",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "micromark": "^4.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-util-types": "^2.0.3",
    "morphdom": "^2.7.8",
    "valibot": "^1.5.0"
  }
}
